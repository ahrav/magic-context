{
  "caps": {
    "individual_before_row": true,
    "row_cap_bytes": 65536,
    "row_size_definition": "sum of UTF-8 byte lengths of every variable name and its value in the selected row",
    "value_cap_bytes": 16384
  },
  "closure_manifest_schema": {
    "closed": true,
    "dependency": {
      "fields": [
        "kind",
        "path"
      ],
      "kinds": [
        "finite_dynamic",
        "native",
        "static"
      ]
    },
    "extensions_ordered": true,
    "fields": [
      "argument_variant",
      "entrypoint",
      "executable",
      "extensions",
      "harness",
      "interpreter",
      "nodes",
      "package",
      "schema",
      "source_roots",
      "version"
    ],
    "id": "magic-context.mc-host-harness-closure/v1",
    "node": {
      "fields": [
        "dependencies",
        "kind",
        "mode",
        "path",
        "sha256",
        "size_bytes",
        "source_path",
        "source_root"
      ],
      "path_rules": [
        "relative",
        "no_parent_segments",
        "no_symlink_escape"
      ]
    },
    "node_kinds": [
      "data",
      "executable",
      "extension",
      "interpreter",
      "module",
      "native_addon"
    ],
    "rules": {
      "finite_dynamic_imports_only": true,
      "no_runtime_import_discovery": true,
      "reachable_native_addons_required": true,
      "relative_layout_preserved": true
    }
  },
  "fingerprint": {
    "canonicalization": "harness-provider-name-length-value/1",
    "domain": "subc-broca-credential-v1",
    "emitted": false,
    "encoding": "concatenation of length-prefixed UTF-8 fields `<decimal byte length>:<field>` in this exact order: the canonicalization tag, the harness id, the canonical provider id, then for each variable in row order its name, its value's decimal byte length, and its value; MACed with a key derived from the authenticated connection bearer under the pinned domain"
  },
  "forbidden_variable_names": [
    "AWS_CONFIG_FILE",
    "AWS_PROFILE",
    "AWS_SHARED_CREDENTIALS_FILE",
    "BUN_INSTALL",
    "DYLD_INSERT_LIBRARIES",
    "DYLD_LIBRARY_PATH",
    "GH_TOKEN",
    "GITHUB_TOKEN",
    "GOOGLE_APPLICATION_CREDENTIALS",
    "HOME",
    "LD_AUDIT",
    "LD_LIBRARY_PATH",
    "LD_PRELOAD",
    "LOGNAME",
    "NODE_OPTIONS",
    "NODE_PATH",
    "NPM_TOKEN",
    "PATH",
    "PWD",
    "SHELL",
    "TMPDIR",
    "USER"
  ],
  "forbidden_variable_prefixes": [
    "GIT_",
    "GPG_",
    "SSH_",
    "XDG_",
    "npm_"
  ],
  "forbidden_variable_suffixes": [
    "_PROXY",
    "_proxy"
  ],
  "harnesses": {
    "opencode": {
      "aliases": {},
      "argument_variants": {
        "control_tokens": [
          "--",
          "--agent",
          "--auth",
          "--config",
          "--continue",
          "--cwd",
          "--env",
          "--extension",
          "--format",
          "--hostname",
          "--log-level",
          "--mode",
          "--model",
          "--output",
          "--port",
          "--print-logs",
          "--provider",
          "--session",
          "--share",
          "--tool",
          "--tools"
        ],
        "raw_argv_allowed": false,
        "variants": {
          "run_prompt": {
            "fields": {
              "model": {
                "pattern": "^[a-z0-9][a-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._/-]*$",
                "position": 2
              },
              "prompt": {
                "position": 3
              }
            },
            "template": [
              "run",
              "--model",
              "{model}",
              "{prompt}"
            ]
          }
        }
      },
      "package": "opencode-ai",
      "providers": {
