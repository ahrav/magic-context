{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "magic-context.secret-scanner-qualification/v1",
	"title": "Secret scanner qualification receipt v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"artifact",
		"manifest",
		"seed",
		"cells",
		"totals",
		"timings",
		"gates",
		"authority_verdict"
	],
	"properties": {
		"schema": { "const": "magic-context.secret-scanner-qualification/v1" },
		"artifact": {
			"type": "object",
			"additionalProperties": false,
			"required": ["file_name", "sha256", "bytes", "identity"],
			"properties": {
				"file_name": { "type": "string", "minLength": 1 },
				"sha256": { "$ref": "#/$defs/sha256" },
				"bytes": { "type": "integer", "minimum": 1 },
				"identity": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"schema",
						"crate_version",
						"semantic_digest",
						"semantic_digest_version",
						"upstream_commit"
					],
					"properties": {
						"schema": {
							"const": "magic-context.secret-scanner-artifact-identity/v1"
						},
						"crate_version": { "type": "string", "minLength": 1 },
						"semantic_digest": { "$ref": "#/$defs/sha256" },
						"semantic_digest_version": { "type": "integer", "minimum": 1 },
						"upstream_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
					}
				}
			}
		},
		"manifest": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"file",
				"sha256",
				"fixture_sha256",
				"planned_scan_quota",
				"status",
				"mode"
			],
			"properties": {
				"file": { "type": "string", "minLength": 1 },
				"sha256": { "$ref": "#/$defs/sha256" },
				"fixture_sha256": { "$ref": "#/$defs/sha256" },
				"planned_scan_quota": { "type": "integer", "minimum": 0 },
				"status": { "enum": ["tooling_only", "frozen"] },
				"mode": { "enum": ["legacy_comparison", "new_authority_legacy_shadow"] }
			}
		},
		"seed": { "type": "integer", "minimum": 0 },
		"cells": {
			"type": "array",
			"minItems": 16,
			"maxItems": 16,
			"items": {
				"type": "object",
				"unevaluatedProperties": false,
				"allOf": [
					{ "$ref": "#/$defs/counts" },
					{
						"type": "object",
						"required": [
							"cell_id",
							"size_class",
							"finding_density",
							"feasibility",
							"quota",
							"divergences",
							"elapsed_ns"
						],
						"properties": {
							"cell_id": { "type": "string", "minLength": 1 },
							"size_class": {
								"enum": ["0_256", "257_4096", "4097_65536", "65537_524288"]
							},
							"finding_density": { "enum": ["0", "1_8", "9_64", "65_plus"] },
							"feasibility": {
								"enum": ["feasible", "impossible", "unassessed"]
							},
							"quota": { "type": "integer", "minimum": 0 },
							"divergences": { "$ref": "#/$defs/divergences" },
							"elapsed_ns": { "type": "integer", "minimum": 0 }
						}
					}
				]
			}
		},
		"totals": {
			"type": "object",
			"unevaluatedProperties": false,
			"allOf": [
				{ "$ref": "#/$defs/counts" },
				{
					"type": "object",
					"required": ["divergences"],
					"properties": { "divergences": { "$ref": "#/$defs/divergences" } }
				}
			]
		},
		"timings": {
			"type": "object",
			"additionalProperties": false,
			"required": ["wall_ns", "artifact_elapsed_ns"],
			"properties": {
				"wall_ns": { "type": "integer", "minimum": 0 },
				"artifact_elapsed_ns": { "type": "integer", "minimum": 0 }
			}
		},
		"gates": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"candidate_authority_mode",
				"matrix_assessed",
				"quota_sum_300000",
				"feasible_cell_minimum_10000",
				"impossible_cells_have_zero_quota",
				"attempted_matches_manifest",
				"fixtures_match",
				"zero_scanner_failures",
				"operational_review_complete",
				"production_divergence_classes_reproduced"
			],
			"properties": {
				"candidate_authority_mode": { "type": "boolean" },
				"matrix_assessed": { "type": "boolean" },
				"quota_sum_300000": { "type": "boolean" },
				"feasible_cell_minimum_10000": { "type": "boolean" },
				"impossible_cells_have_zero_quota": { "type": "boolean" },
				"attempted_matches_manifest": { "type": "boolean" },
				"fixtures_match": { "type": "boolean" },
				"zero_scanner_failures": { "type": "boolean" },
				"operational_review_complete": { "type": "boolean" },
				"production_divergence_classes_reproduced": { "type": "boolean" }
			}
		},
		"authority_verdict": { "enum": ["qualified", "refused"] }
	},
	"$defs": {
		"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"divergences": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"match",
				"legacy_only",
				"portable_only",
				"different_output",
				"portable_error"
			],
			"properties": {
				"match": { "type": "integer", "minimum": 0 },
				"legacy_only": { "type": "integer", "minimum": 0 },
				"portable_only": { "type": "integer", "minimum": 0 },
				"different_output": { "type": "integer", "minimum": 0 },
				"portable_error": { "type": "integer", "minimum": 0 }
			}
		},
		"counts": {
			"type": "object",
			"required": [
				"attempted",
				"completed",
				"rejected",
				"scanner_failures",
				"incomplete_reports",
				"invalid_spans"
			],
			"properties": {
				"cell_id": { "type": "string", "minLength": 1 },
				"attempted": { "type": "integer", "minimum": 0 },
				"completed": { "type": "integer", "minimum": 0 },
				"rejected": { "type": "integer", "minimum": 0 },
				"scanner_failures": { "type": "integer", "minimum": 0 },
				"incomplete_reports": { "type": "integer", "minimum": 0 },
				"invalid_spans": { "type": "integer", "minimum": 0 },
				"divergences": { "$ref": "#/$defs/divergences" },
				"elapsed_ns": { "type": "integer", "minimum": 0 }
			}
		}
	}
}
