{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cortexkit/magic-context/schemas/mc-shm-release-gate-report-v1.json",
  "title": "Installed shared-memory release gate report v1",
  "oneOf": [
    { "$ref": "#/$defs/blocked" },
    { "$ref": "#/$defs/ready" },
    { "$ref": "#/$defs/complete" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executable_sha256"],
      "properties": {
        "name": { "enum": ["bun", "node", "rust"] },
        "version": { "type": "string", "minLength": 1 },
        "executable_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id_sha256", "kernel", "cpu", "topology_sha256"],
      "properties": {
        "id_sha256": { "$ref": "#/$defs/sha256" },
        "kernel": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string", "minLength": 1 },
        "topology_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "package", "runtime", "host", "harness_sha256", "workload_sha256"],
      "properties": {
        "source_commit": { "$ref": "#/$defs/commit" },
        "package": { "$ref": "#/$defs/package" },
        "runtime": { "$ref": "#/$defs/runtime" },
        "host": { "$ref": "#/$defs/host" },
        "harness_sha256": { "$ref": "#/$defs/sha256" },
        "workload_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50_latency_ns", "p99_latency_ns", "throughput_ops_per_second", "body_copies", "allocations", "cpu_ns", "wakeups"],
      "properties": {
        "p50_latency_ns": { "type": "number", "exclusiveMinimum": 0 },
        "p99_latency_ns": { "type": "number", "exclusiveMinimum": 0 },
        "throughput_ops_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "body_copies": { "type": "integer", "minimum": 0 },
        "allocations": { "type": "integer", "minimum": 0 },
        "cpu_ns": { "type": "integer", "exclusiveMinimum": 0 },
        "wakeups": { "type": "integer", "minimum": 0 }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "metrics"],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "metrics": { "$ref": "#/$defs/metrics" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50_ratio", "p99_ratio", "throughput_ratio", "copies_delta", "allocations_delta", "cpu_ratio", "wakeups_delta"],
      "properties": {
        "p50_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "p99_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "throughput_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "copies_delta": { "type": "integer" },
        "allocations_delta": { "type": "integer" },
        "cpu_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "wakeups_delta": { "type": "integer" }
      }
    },
    "runtimeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "baseline", "candidate", "comparison"],
      "properties": {
        "runtime": { "enum": ["bun", "node"] },
        "baseline": { "$ref": "#/$defs/arm" },
        "candidate": { "$ref": "#/$defs/arm" },
        "comparison": { "$ref": "#/$defs/comparison" }
      }
    },
    "blocked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "verdict", "blockers", "baseline", "candidate", "comparison"],
      "properties": {
        "schema": { "const": "magic-context.mc-shm-release-gate-report/v1" },
        "verdict": { "const": "blocked" },
        "blockers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "baseline": { "type": "null" },
        "candidate": { "type": "null" },
        "comparison": { "type": "null" }
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "verdict"],
      "properties": {
        "schema": { "const": "magic-context.mc-shm-release-gate-report/v1" },
        "verdict": { "const": "ready" }
      }
    },
    "complete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "verdict", "claim", "runtime_results"],
      "properties": {
        "schema": { "const": "magic-context.mc-shm-release-gate-report/v1" },
        "verdict": { "const": "evidence_complete" },
        "claim": { "const": "descriptive_only_no_performance_threshold" },
        "runtime_results": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/runtimeResult" },
                {
                  "properties": {
                    "runtime": { "const": "bun" },
                    "baseline": { "properties": { "identity": { "properties": { "runtime": { "properties": { "name": { "const": "bun" } } } } } } },
                    "candidate": { "properties": { "identity": { "properties": { "runtime": { "properties": { "name": { "const": "bun" } } } } } } }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/runtimeResult" },
                {
                  "properties": {
                    "runtime": { "const": "node" },
                    "baseline": { "properties": { "identity": { "properties": { "runtime": { "properties": { "name": { "const": "node" } } } } } } },
                    "candidate": { "properties": { "identity": { "properties": { "runtime": { "properties": { "name": { "const": "node" } } } } } } }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      }
    }
  }
}
