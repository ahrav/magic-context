{
	"$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"assist": {
		"enabled": true
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noForEach": "off"
			},
			"style": {
				"noNonNullAssertion": "warn",
				"useConst": "error"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noAssignInExpressions": "off",
				"noTemplateCurlyInString": "off"
			}
		}
	},
	"files": {
		"includes": ["src/**/*.ts", "!dist", "!node_modules"]
	},
	"overrides": [
		{
			"includes": ["**/__tests__/**", "**/*.test.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"includes": [
				"src/tools/ctx-memory.ts",
				"src/tools/ctx-search.ts",
				"src/tools/index.ts",
				"src/kernel-client-pi.ts",
				"src/inject-compartments-pi.ts",
				"src/context-handler.ts",
				"src/auto-search-pi.ts",
				"src/dialogs/status-dialog.ts",
				"src/commands/ctx-status.ts",
				"src/clone-inheritance.ts",
				"src/pi-historian-runner.ts",
				"!**/*.test.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/storage-claim*"],
										"message": "Memory-path files read and write project memory through the kernel client, never the claim lane."
									},
									{
										"group": ["**"],
										"importNamePattern": "readAuthorizedClaimMemorySnapshot|readProjectClaimLaneSnapshot|executeCtxMemoryClaimAction",
										"message": "Memory-path files read and write project memory through the kernel client, never the claim lane."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
