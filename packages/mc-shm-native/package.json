{
  "name": "@magic-context/mc-shm-native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "build": "cargo build -p mc-shm-native && cp -f ../../target/debug/libmc_shm_native.$(test \"$(uname -s)\" = Darwin && echo dylib || echo so) ./mc_shm_native.node",
    "build:source": "bun run build",
    "test": "bun test tests",
    "test:bun": "bun test tests",
    "test:node": "node --experimental-transform-types tests/runtime.ts",
    "test:capability:bun": "bun tests/capability.ts",
    "test:capability:node": "node --experimental-transform-types tests/capability.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.8.0"
  }
}
