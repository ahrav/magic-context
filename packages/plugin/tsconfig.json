{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "lib": [
            "ES2022"
        ],
        "outDir": "dist",
        "rootDir": "src",
        "types": [
            "node",
            "bun-types"
        ],
        "baseUrl": ".",
        "paths": {
            "@cortexkit/retina-local-fs/*": [
                "../retina-local-fs/dist/types/*",
                "../retina-local-fs/src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "scripts",
        "src/**/*.test.ts",
        "src/**/__tests__/**"
    ],
    "references": [
        {
            "path": "../retina-local-fs/tsconfig.build.json"
        }
    ]
}
