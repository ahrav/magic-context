{
  "name": "@cortexkit/opencode-magic-context",
  "version": "0.37.0",
  "type": "module",
  "description": "OpenCode plugin for Magic Context — cross-session memory and context management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "ualtinok",
  "license": "MIT",
  "keywords": [
    "opencode",
    "plugin",
    "context",
    "memory",
    "ai",
    "llm",
    "prompt-caching",
    "session-history"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cortexkit/magic-context",
    "directory": "packages/plugin"
  },
  "files": [
    "dist",
    "src/tui",
    "src/tui-compiled",
    "src/shared",
    "src/config",
    "src/agents",
    "src/features/magic-context/defaults.ts",
    "src/features/magic-context/dreamer/cron.ts",
    "src/features/magic-context/dreamer/task-registry.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p ../retina-local-fs/tsconfig.build.json && bun run build:tui && rm -f dist/index.js dist/*-*.js && bun build src/index.ts --outdir dist --target node --format esm --splitting --external @opencode-ai/plugin --external @huggingface/transformers --external onnxruntime-web --external bun:sqlite --external node:sqlite && tsc --emitDeclarationOnly",
    "build:tui": "bun scripts/build-tui.ts",
    "check:tui-compiled": "bun run build:tui && git diff --exit-code -- src/tui-compiled && test -z \"$(git status --porcelain -- src/tui-compiled)\"",
    "typecheck": "tsc -p ../retina-local-fs/tsconfig.build.json && tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "bun test",
    "test:mc-host-client:node": "bun scripts/run-mc-host-client-node.ts adversarial",
    "smoke:mc-host-client:bun": "bun scripts/smoke-mc-host-client.ts",
    "smoke:mc-host-client:node": "bun scripts/run-mc-host-client-node.ts smoke",
    "smoke:mc-host-synapse:bun": "bun scripts/smoke-mc-host-synapse.ts",
    "smoke:mc-host-synapse:node": "bun scripts/run-mc-host-client-node.ts synapse",
    "lint": "biome check .",
    "bench:retrieval": "bun scripts/benchmark-retrieval.ts",
    "bench:retrieval:check": "bun scripts/benchmark-retrieval.ts check --profile ci",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build && bun run build:tui"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "@jitl/quickjs-singlefile-cjs-release-asyncify": "0.32.0",
    "@opencode-ai/plugin": "^1.17.11",
    "@opencode-ai/sdk": "^1.17.11",
    "@opentui/core": "^0.4.2",
    "@opentui/solid": "^0.4.2",
    "ai-tokenizer": "^1.0.6",
    "comment-json": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "quickjs-emscripten": "^0.32.0",
    "solid-js": "1.9.12",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "3.0.82",
    "@ai-sdk/openai-compatible": "2.0.41",
    "@biomejs/biome": "^2.5.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.10",
    "@types/node": "^22.20.0",
    "bun-types": "^1.3.10",
    "typescript": "^5.8.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./src/tui/index.tsx",
      "import": "./src/tui/entry.mjs"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.15.0"
  }
}
