      },
      {
        "user": "Also indentation is 4 spaces, never tabs.",
        "assistant": "Recorded: indentation is 4 spaces, never tabs."
      },
      {
        "user": "Formatting rules are settled then.",
        "assistant": "Closing the formatting thread."
      }
    ],
    "epilogueStartIndex": 3
  },
