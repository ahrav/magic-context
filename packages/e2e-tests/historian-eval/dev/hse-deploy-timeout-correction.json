      {
        "user": "And rollouts always proceed one availability zone at a time.",
        "assistant": "Recorded: rollouts proceed one availability zone at a time."
      },
      {
        "user": "That's everything for the deployment settings.",
        "assistant": "Wrapping up the deployment thread."
      }
    ],
    "epilogueStartIndex": 3
  },
  "trigger": {
    "expectedHistorianRuns": 2,
    "modelContextLimit": 200000,
    "usageTokensPerTurn": 1000,
    "spikeUsageTokens": 90000,
