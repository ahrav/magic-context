{
    "name": "@cortexkit/magic-context",
    "version": "0.38.0",
    "description": "Unified CLI for Magic Context — setup, doctor, and migration across OpenCode, Pi, and OMP",
    "keywords": [
        "opencode",
        "opencode-plugin",
        "pi",
        "pi-extension",
        "omp",
        "oh-my-pi",
        "magic-context",
        "cli",
        "setup",
        "doctor"
    ],
    "author": "Cortexkit",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/cortexkit/magic-context"
    },
    "homepage": "https://github.com/cortexkit/magic-context#readme",
    "bugs": {
        "url": "https://github.com/cortexkit/magic-context/issues"
    },
    "type": "module",
    "bin": {
        "magic-context": "dist/index.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "bun build src/index.ts --outfile dist/index.js --target node --format esm --external node:sqlite --external jsonc-parser",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "lint": "biome check src",
        "format": "biome format --write src",
        "format:check": "biome format src",
        "prepublishOnly": "bun run build"
    },
    "dependencies": {
        "@clack/prompts": "^1.6.0",
        "comment-json": "^5.0.0",
        "jsonc-parser": "^3.3.1"
    },
    "optionalDependencies": {
        "@cortexkit/mc-host-darwin-arm64": "0.38.0",
        "@cortexkit/mc-host-darwin-x64": "0.38.0",
        "@cortexkit/mc-host-linux-x64-gnu": "0.38.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.20.0",
        "bun-types": "^1.3.11",
        "typescript": "^5.8.0"
    },
    "engines": {
        "node": ">=24.15.0"
    }
}
