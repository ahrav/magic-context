#!/usr/bin/env sh
# --- BEGIN BEADS INTEGRATION v1.2.2 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  _bd_used_perl=0
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v perl >/dev/null 2>&1; then
    _bd_used_perl=1
    perl -e 'alarm shift; exec @ARGV' "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  else
    echo >&2 "beads: hook 'pre-commit' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    bd hooks run pre-commit "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 124 ] || { [ $_bd_used_perl -eq 1 ] && [ $_bd_exit -eq 142 ]; }; then
    echo >&2 "beads: hook 'pre-commit' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-commit'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v1.2.2 ---

# Comment hygiene on staged source files.
staged=$(git diff --cached -z --name-only --diff-filter=ACMR -- "*.rs" "*.ts" "*.tsx" "*.js" "*.mjs" "*.cjs" "*.py" "*.sh" "*.ps1" "*.yml" "*.yaml" "*.toml" "*.jsonc" "*.css" ".beads/hooks/*" | tr '\0' '\n')
# A staged export can turn a previously harmless token in an unchanged comment into a
# finding, so it triggers a whole-tree scan of its own.
ids_staged=0
if ! git diff --cached --quiet -- .beads/issues.jsonl 2>/dev/null; then ids_staged=1; fi
if { [ -n "$staged" ] || [ "$ids_staged" -eq 1 ]; } && [ -f scripts/check-comments.sh ]; then
  root=$(git rev-parse --show-toplevel) || exit 1
  work=$(mktemp -d) || exit 1
  trap 'rm -rf "$work"' EXIT HUP INT TERM

  # A partially staged file differs from its working-tree copy, so the scan reads
  # index content to judge what the commit will actually contain.
  # A heredoc keeps the loop in this shell, so a path holding whitespace stays one
  # argument and a materialization failure aborts the commit.
  set --
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in */*) mkdir -p "$work/${f%/*}" || exit 1 ;; esac
    git cat-file blob ":$f" > "$work/$f" || exit 1
    set -- "$@" "$work/$f"
  done <<STAGED
$staged
STAGED

  # The ID export decides which short forms resolve, so a staged change to it
  # belongs in the same view of the commit as the sources.
  ids="$root/.beads/issues.jsonl"
  if [ "$ids_staged" -eq 1 ]; then
    if git cat-file blob :.beads/issues.jsonl > "$work/issues.jsonl" 2>/dev/null; then
      ids="$work/issues.jsonl"
    fi
  fi

  # The scanner itself may be partially staged, so run the version being committed.
  gate="$root/scripts/check-comments.sh"
  if ! git diff --cached --quiet -- scripts/check-comments.sh 2>/dev/null; then
    if git cat-file blob :scripts/check-comments.sh > "$work/gate.sh" 2>/dev/null; then
      gate="$work/gate.sh"
    fi
  fi

  if ! out=$(COMMENT_CHECK_IDS="$ids" sh "$gate" "$@" 2>&1); then
    printf '%s\n' "$out" | sed "s|$work/||g" >&2
    exit 1
  fi

  # A grown export can make an unchanged comment a finding, so the whole tree is
  # checked against it whenever it is staged, not only when it is staged alone.
  if [ "$ids_staged" -eq 1 ] && [ "$#" -gt 0 ]; then
    if ! out=$(COMMENT_CHECK_IDS="$ids" sh "$gate" 2>&1); then
      printf '%s\n' "$out" >&2
      exit 1
    fi
  fi
fi
