# Plugin README is generated from the root README when packaging.
packages/plugin/README.md
.bg-shell/

# Keep only the final animation; iteration folders stay local
packages/plugin/docs/animation[0-9]*/

.pi/

# Local agent task outputs and Magic Context dogfooding state.
.cortexkit/

# Prompt/model experiment harnesses (model-dispatch, replay, migration validation).
# Kept on disk for reuse but excluded from git + CI typecheck: they intentionally
# track in-flight prompt/signature shapes that drift faster than production src,
# so committing them would couple CI to experiment state. Production generators
# (scripts/build-*.ts) stay tracked because builds and tests use them.
packages/plugin/scripts/experiments/
scripts/experiments/
# Same experiment harnesses when dropped at scripts/ root (not under experiments/).
packages/plugin/scripts/lib/
packages/plugin/scripts/claude-oauth.ts
packages/plugin/scripts/dump-historian-view.ts
packages/plugin/scripts/replay-historian.ts
packages/plugin/scripts/test-historian-prompt.ts

# CodeGraph index (local tree-sitter knowledge graph; rebuilt on demand).
.codegraph/

# Local scratch directories — checkouts dropped here for one-off lookups
.tmp-*/

# Internal SUBC-migration design docs / specs (not public)
docs/cache-policy/
docs/specs/

# Rust workspace build output
/target
/target-*

# Standalone evidence crates under docs/evidence/ (workspace-excluded; compiled
# ad hoc for verification) — their build output and lockfiles are throwaway.
# The workspace-root Cargo.lock stays tracked.
docs/evidence/**/target/
docs/evidence/**/Cargo.lock

# Local mc-host qualification output. These records are generated from
# machine-specific campaigns and must not be committed.
docs/evidence/mc-host-installed-release-evidence.json
docs/evidence/mc-host-release-qualification.json
docs/evidence/mc-host-synapse-smoke.json

# Source-built N-API modules stay local; CI never publishes prebuilds.
*.node

# Local experiment scratch under scripts/experiments/ — dev-only harnesses and
# their outputs, several run against real session/memory data and must never be
# tracked.
packages/plugin/scripts/experiments/gap-heal/
packages/plugin/scripts/experiments/language/
packages/plugin/scripts/experiments/maintain-memory/
packages/plugin/scripts/experiments/primers/
packages/plugin/scripts/experiments/smart-drops/
packages/plugin/scripts/experiments/caveman/
packages/plugin/scripts/experiments/bench-local-embed.ts
packages/plugin/scripts/experiments/issue-195-repro.mjs
packages/plugin/scripts/mural-test-output/
# Interrupted benchmark-release promotions must never become committable.
packages/plugin/scripts/fixtures/retrieval-benchmark/.staging-*/
packages/e2e-tests/historian-eval/**/.staging-*/
packages/e2e-tests/pools/.atomic-json-*/
# Nor the promotion lock: it outlives a crashed promoter by design, and a tracked
# copy would refuse every promotion in every checkout at the wx creation step.
packages/e2e-tests/historian-eval/**/.promote.lock
AgentLogs/
.agent-logs/
tests/docker/.generated/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Retired dashboard updater signing keys: maintainer checkouts that generated
# one still hold the ignored private key on disk after the package deletion,
# and without this rule a routine `git add -A` would stage it.
packages/dashboard/.tauri-keys/

docs/plans/
docs/fork-hardening-audit.md

# Perf evidence and research/audit reports are local working artifacts:
# host- and build-specific, regenerated by scripts/perf-mc-host.sh and by
# audit runs, so they stay out of the repository.
docs/perf/
docs/research/

# The addon's JS entry point is generated by `bun run build:js` from index.ts
# and shipped via `files`/`prepack`. Dockerfiles COPY it, so it must exist at
# build time, but it is a build product and never a source of truth.
packages/mc-shm-native/index.js
